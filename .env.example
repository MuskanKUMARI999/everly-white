NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (test keys from https://dashboard.razorpay.com/app/keys)
# If omitted, checkout runs in simulated/demo mode.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-key-secret

# Set when registering the webhook (Razorpay Dashboard -> Settings -> Webhooks) for the
# /api/webhooks/razorpay endpoint. This is separate from the API key secret above — it signs
# the raw webhook body. If omitted, the webhook endpoint rejects all deliveries; payments still
# complete via the browser callback, but orders are not fulfilled if the customer closes the tab.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Resend (email — API key from https://resend.com/api-keys)
# If omitted, all transactional emails are skipped (logged to console instead).
# RESEND_FROM_EMAIL must be on a domain verified in Resend; the mailbox itself need not exist.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Everly White <orders@yourdomain.com>"

# Where customer replies land. Set this when the from address above is a send-only alias,
# otherwise replies are silently lost. Optional — omit to let replies go to the from address.
RESEND_REPLY_TO=info@everlywhite.com

# Where owner alerts go (new paid order, new contact message). This is the shop's own inbox, not
# the customer-facing reply-to above. If omitted, alerts are skipped and orders still complete.
ADMIN_ALERT_EMAIL=info@everlywhite.com

# Absolute origin used for links and the logo in emails. Mail clients have no page context, so
# without this every email link points at localhost. Also drives the sitemap, robots.txt, the
# canonical/OpenGraph tags and the password-reset redirect.
#
# NEXT_PUBLIC_ values are INLINED AT BUILD TIME. This must be correct in the environment where the
# build runs — setting it on the host afterwards does nothing, it needs a rebuild. Note also that
# .env.local outranks .env.production, so the repo keeps a .env.production.local (no secrets, just
# this variable) to stop a local production build inheriting the localhost dev value.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
