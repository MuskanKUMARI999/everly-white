# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the template. It holds no values, only the variable names and notes
# on what each one does, so it is the record of what must be configured on the host.
!.env.example
# ...and keep the production origin. It holds a single NEXT_PUBLIC_ value, which is shipped to the
# browser and therefore public by definition — no secret is exposed by tracking it. It must travel
# with the source, because NEXT_PUBLIC_ vars are inlined at build time: if the build machine lacks
# this file it silently falls back to the localhost default and every email link, canonical tag and
# sitemap entry ships pointing at localhost.
!.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify
